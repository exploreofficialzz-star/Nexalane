; NEXALANE: 3D Endless Runner
; Godot 4.7.x target. Mobile renderer default.
config_version=5

[application]
config/name="NEXALANE: 3D Endless Runner"
run/main_scene="res://ui/Main.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://assets/icon/nexalane_icon_1024.png"
config/quit_on_go_back=false
boot_splash/bg_color=Color(0.025, 0.04, 0.07, 1)
boot_splash/show_image=false

[display]
window/size/viewport_width=1080
window/size/viewport_height=1920
window/size/window_width_override=540
window/size/window_height_override=960
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[rendering]
renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
textures/vram_compression/import_etc2_astc=true
textures/default_filters/use_nearest_mipmap_filter=false
textures/default_filters/anisotropic_filtering_level=2
lights_and_shadows/directional_shadow/size.mobile=2048
environment/defaults/default_clear_color=Color(0.02, 0.03, 0.05, 1)

[physics]
common/physics_interpolation=true
common/enable_pause_aware_picking=true

[autoload]
AppState="*res://autoload/app_state.gd"
ConsentService="*res://services/consent_service.gd"
SaveService="*res://save/save_service.gd"
AnalyticsService="*res://services/analytics/analytics_service.gd"
EconomyService="*res://economy/economy_service.gd"
ProgressionService="*res://progression/progression_service.gd"
DeviceProfileService="*res://core/device_profile_service.gd"
RunDirector="*res://core/run_director.gd"
GameModeService="*res://core/game_mode_service.gd"
ReplaySeedService="*res://core/replay_seed_service.gd"
ChallengeService="*res://core/challenge_service.gd"
AudioService="*res://audio/audio_service.gd"
AdsService="*res://services/ads/ads_service.gd"
BillingService="*res://services/billing/billing_service.gd"
BackendService="*res://services/backend/backend_service.gd"
RemoteConfigService="*res://services/remote_config/remote_config_service.gd"
LiveOpsService="*res://liveops/live_ops_service.gd"
AccessibilityService="*res://services/accessibility_service.gd"
MissionService="*res://progression/missions/mission_service.gd"
AchievementService="*res://progression/achievements/achievement_service.gd"
LeaderboardService="*res://social/leaderboards/leaderboard_service.gd"
GhostService="*res://social/ghosts/ghost_service.gd"
ShopService="*res://economy/shop/shop_service.gd"
SeasonEngine="*res://liveops/seasons/season_engine.gd"
EventEngine="*res://liveops/events/event_engine.gd"

[layer_names]
3d_physics/layer_1="Runner"
3d_physics/layer_2="World"
3d_physics/layer_3="Collectible"
3d_physics/layer_4="Trigger"

[application_metadata]
product_version="0.4.5"
content_version="2026.10.03"
tuning_version="5"
